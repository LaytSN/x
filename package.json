{
  "name": "vkplay-tizenbrew-client",
  "version": "0.1.0",
  "description": "Samsung Tizen TV compatibility layer for VK Play Cloud",
  "packageType": "mods",
  "appName": "VK Play Cloud TV",
  "websiteURL": "https://cloud.vkplay.ru/",
  "main": "mods/inject.js",
  "evaluateScriptOnDocumentStart": true,
  "keys": [
    "ColorF0Red",
    "ColorF1Green",
    "ColorF2Yellow",
    "ColorF3Blue",
    "MediaPlayPause",
    "MediaPlay",
    "MediaPause",
    "MediaStop"
  ],
  "license": "MIT"
}
